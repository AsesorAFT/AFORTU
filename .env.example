# Copia este archivo a .env.local y completa los valores. NUNCA subas claves reales.

# === Firebase (claves públicas del cliente web) ===
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=afortu.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=afortu
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=afortu.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# === App ===
NEXT_PUBLIC_URL=http://localhost:3001

# === Genkit / Google AI (servidor) ===
GEMINI_API_KEY=

# === Alpha Vantage (servidor; src/services/stock-price-service.ts) ===
FINANCE_API_KEY=

# === PayPal (servidor; src/app/api/paypal/**) ===
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=

# === AFORTU API (servidor) ===
AFORTU_API_BASE_URL=https://api.afortu.com
AFORTU_API_KEY=
